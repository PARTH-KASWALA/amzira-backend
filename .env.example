# Copy to .env only on the deployment host. Never commit real values.
DB_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://amzira_user:replace-with-a-long-random-password@db:5432/amzira_db

SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production
DEBUG=False
TESTING=False
CHECKOUT_ENABLED=False
COD_ENABLED=False

RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

BACKEND_CORS_ORIGINS=["https://amzira.com","https://www.amzira.com"]
FRONTEND_URL=https://amzira.com
HEALTHCHECK_TOKEN=replace-with-a-separate-random-token
ADMIN_EMAIL=admin@amzira.com
ADMIN_ALLOWED_IPS=replace-with-admin-public-ip
TRUST_PROXY_HEADERS=True
TRUSTED_PROXY_IPS=127.0.0.1,::1
DEFAULT_ADMIN_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@amzira.com
SMTP_PASSWORD=replace-with-provider-app-password
EMAILS_FROM_EMAIL=noreply@amzira.com
EMAILS_FROM_NAME=AMZIRA
EMAILS_FROM_ORDERS=orders@amzira.com
EMAILS_FROM_SHIPPING=shipping@amzira.com
EMAILS_FROM_SUPPORT=support@amzira.com

SHIPROCKET_EMAIL=replace_me
SHIPROCKET_PASSWORD=replace_me
SHIPROCKET_WEBHOOK_SECRET=replace_me
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=replace-with-6-digits
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=5
SHIPROCKET_TOKEN_TTL_SECONDS=864000
SHIPROCKET_MAX_RETRIES=3

R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=amzira-products
R2_PUBLIC_URL=https://cdn.amzira.com
UPLOAD_DIR=static/uploads/products
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=["jpg","jpeg","png","webp"]

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_STORE_EAGER_RESULT=False

GST_RATE=0.05
FREE_SHIPPING_THRESHOLD=2000
DEFAULT_SHIPPING_CHARGE=100
SENTRY_DSN=
ALLOW_STARTUP_SCHEMA_PATCHING=False
